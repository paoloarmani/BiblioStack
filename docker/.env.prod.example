# Configurazione dello stack di PRODUZIONE (docker/compose.prod.yml).
# Copiare in docker/.env.prod (ignorato da git) e compilare. I valori senza default sono obbligatori.
# Segreti robusti: openssl rand -base64 48

# --- Indirizzo pubblico ---
# Dominio servito da Caddy. Con un dominio pubblico il certificato HTTPS è automatico (Let's Encrypt,
# porte 80/443 aperte verso Internet). Con localhost o un IP (es. https://192.168.1.10) Caddy usa un
# certificato interno. Con ":80" Caddy serve solo HTTP (HTTPS gestito da un proxy esterno).
SITE_ADDRESS=biblioteca.scuola.it
# URL completo con cui gli utenti aprono l'app (CORS e link nelle email)
PUBLIC_URL=https://biblioteca.scuola.it
# Porte pubblicate sull'host
HTTP_PORT=80
HTTPS_PORT=443
# Proxy fidati davanti al backend: 1 = solo Caddy, 2 = Caddy dietro un altro proxy
TRUST_PROXY_HOPS=1

# --- Database e Redis (non esposti fuori da Docker) ---
POSTGRES_USER=bibliostack
POSTGRES_PASSWORD=
POSTGRES_DB=bibliostack
REDIS_PASSWORD=

# --- Segreti applicativi ---
JWT_SECRET=
JWT_REFRESH=
CARD_SECRET=
LOG_LEVEL=info

# --- Accesso con Google ---
# OBBLIGATORIO: domini le cui email possono creare un account entrando con Google (separati da virgola).
# Senza GOOGLE_CLIENT_ID il login Google resta disattivato, ma il valore va comunque impostato.
ALLOWED_GOOGLE_DOMAINS=scuola.edu.it
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Integrazioni (facoltative) ---
# Senza RESEND_API_KEY le email (reset password, avvisi) non partono
# ALLOW_PUBLIC_REGISTRATION=false
# GOOGLE_BOOKS_API_KEY=
# RESEND_API_KEY=re_...
