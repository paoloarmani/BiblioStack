# Configurazione dello stack di PRODUZIONE (docker/compose.prod.yml).
# Copiare in docker/.env.prod (ignorato da git) e compilare. I valori senza default sono obbligatori.
# Segreti robusti: openssl rand -base64 48

# --- Indirizzo pubblico ---
# Dominio servito da Caddy. Con un dominio pubblico il certificato HTTPS è automatico (Let's Encrypt,
# porte 80/443 aperte verso Internet). Con localhost o un IP (es. https://192.168.1.10) Caddy usa un
# certificato interno. Con ":80" Caddy serve solo HTTP (HTTPS gestito da un proxy esterno).
SITE_ADDRESS=biblioteca.scuola.it
# URL completo con cui gli utenti aprono l'app (CORS e link nelle email)
PUBLIC_URL=https://biblioteca.scuola.it
# Porte pubblicate sull'host
HTTP_PORT=80
HTTPS_PORT=443
# Proxy fidati davanti al backend: 1 = solo Caddy, 2 = Caddy dietro un altro proxy
TRUST_PROXY_HOPS=1
# Solo dietro un proxy esterno (SITE_ADDRESS=:80): da quali indirizzi accettare X-Forwarded-For
# (private_ranges = reti private, oppure l'IP del proxy). Lasciare vuoto se Caddy è esposto direttamente.
# TRUSTED_PROXIES=private_ranges

# --- Database e Redis (non esposti fuori da Docker) ---
POSTGRES_USER=bibliostack
POSTGRES_PASSWORD=
POSTGRES_DB=bibliostack
# Ruolo usato dal backend, con soli permessi sui dati (POSTGRES_USER resta per migrazioni e backup).
# Finisce in un URL di connessione: generarla con  openssl rand -hex 32  (niente / + @)
APP_DB_USER=bibliostack_app
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Segreti applicativi ---
JWT_SECRET=
JWT_REFRESH=
CARD_SECRET=
LOG_LEVEL=info

# --- Accesso con Google ---
# OBBLIGATORIO: domini le cui email possono creare un account entrando con Google (separati da virgola).
# Senza GOOGLE_CLIENT_ID il login Google resta disattivato, ma il valore va comunque impostato.
ALLOWED_GOOGLE_DOMAINS=scuola.edu.it
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Posta in uscita (reset password, attivazione account, avvisi di prestito) ---
# Consigliato: l'account tecnico creato dall'ente sul proprio provider di posta (SMTP).
# Porta 587 = STARTTLS (obbligatorio), 465 = TLS implicito. Esempi di host:
#   Microsoft 365: smtp.office365.com:587   Google Workspace: smtp.gmail.com:587 (password per le app)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=biblioteca@scuola.it
# SMTP_PASS=
# Mittente mostrato nelle email; di norma deve coincidere con SMTP_USER o un suo alias autorizzato
# EMAIL_FROM=Biblioteca ITT Pozzo <biblioteca@scuola.it>
# Solo per un relay interno senza cifratura (sconsigliato): SMTP_REQUIRE_TLS=false
#
# In alternativa (senza SMTP_HOST) Resend: serve un dominio verificato in EMAIL_FROM,
# altrimenti il mittente di prova consegna solo all'email del proprietario dell'account Resend.
# RESEND_API_KEY=re_...
#
# Tetto globale sugli invii (protegge la quota del provider). Default: 500/giorno con SMTP,
# 90/giorno e 2900/mese con Resend. 0 = nessun limite.
# EMAIL_DAILY_LIMIT=500
# EMAIL_MONTHLY_LIMIT=0

# --- Limite generale sulle API (richieste al minuto, 0 = disattivato) ---
# Per utente autenticato; per IP gli anonimi (più alto: a scuola molti condividono lo stesso IP pubblico)
# API_RATE_LIMIT_USER=300
# API_RATE_LIMIT_ANON=600

# --- Biblioteca (footer del sito; tutto facoltativo, i campi vuoti non compaiono) ---
# LIBRARY_NAME=Biblioteca ITT "A. Pozzo"
# LIBRARY_INSTITUTION=Istituto Tecnico Tecnologico "Andrea Pozzo"
# LIBRARY_ADDRESS=Via ..., 38122 Trento
# LIBRARY_EMAIL=biblioteca@scuola.it
# LIBRARY_PHONE=0461 000000
# Orari: più righe separate da |
# LIBRARY_HOURS=Lun-Ven 8:00-13:00|Mar e Gio anche 14:00-16:00
# LIBRARY_WEBSITE_URL=https://www.scuola.it
# Informativa privacy dell'ente (obbligatoria per legge: di norma è già sul sito della scuola)
# LIBRARY_PRIVACY_URL=https://www.scuola.it/privacy
# LIBRARY_RULES_URL=https://www.scuola.it/biblioteca/regolamento

# --- Integrazioni (facoltative) ---
# ALLOW_PUBLIC_REGISTRATION=false
# GOOGLE_BOOKS_API_KEY=
